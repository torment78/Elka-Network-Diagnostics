<Window x:Class="Elka.NetworkDiagnostics.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Elka Network Diagnostics" Width="1260" Height="900" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen">
 <Grid Margin="18,12,18,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="#20392F" CornerRadius="10" Margin="0,0,13,0"><TextBlock Text="⇄" Foreground="{StaticResource Accent}" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Elka Network Diagnostics" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Two endpoints. Clear evidence. Controlled repairs." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="LOCAL TOOLS READY" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" FontSize="11"/><TextBlock Text="ElkaSoft  /  Foundation 0.2.2" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="THIS PC" Style="{StaticResource Caption}"/><Button Content="Refresh" HorizontalAlignment="Right" Padding="8,2" Command="{Binding RefreshCommand}"/></Grid>
    <ComboBox Grid.Row="1" ItemsSource="{Binding Adapters}" DisplayMemberPath="Label" SelectedItem="{Binding Adapter}" IsEnabled="{Binding CanConfigure}" Margin="0,3,0,10"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ThisPcName}" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="Both PCs send and receive.&#10;Run checks from either one." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="CONTROL / TEST PORT" Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding ControlPort,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}"/><TextBox Grid.Column="2" Text="{Binding TestPort,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}"/></Grid></StackPanel></Grid>
    <TextBlock Grid.Row="3" Text="{Binding AdapterSummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="PEER CONNECTION" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ConnectionLabel}" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontSize="11"/></Grid>
    <Grid Grid.Row="1" Margin="0,3,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PeerAddress,UpdateSourceTrigger=PropertyChanged}" ToolTip="Other PC's physical IPv4 address" IsEnabled="{Binding CanConfigure}"/><Button Grid.Column="1" Content="Find on LAN" Command="{Binding DiscoverCommand}" Margin="8,0,0,0"/><Button Grid.Column="2" Content="{Binding EndpointButton}" Command="{Binding EndpointCommand}" Style="{StaticResource Primary}" Margin="8,0,0,0"/></Grid>
    <StackPanel Grid.Row="2"><TextBlock Text="PAIRING CODE  ·  COPY THE SAME CODE TO BOTH PCS" Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding PairingCode,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" MaxLength="32" IsEnabled="{Binding CanConfigure}"/><Button Grid.Column="1" Content="New" Padding="10,8" Margin="8,0,0,0" Command="{Binding NewCodeCommand}"/><Button Grid.Column="2" Content="Copy" Padding="10,8" Margin="6,0,0,0" Command="{Binding CopyCodeCommand}"/></Grid></StackPanel>
    <TextBlock Grid.Row="3" Text="{Binding TransportLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
   </Grid></Border>
  </Grid>
  <TabControl x:Name="WorkspaceTabs" Grid.Row="2" SelectedIndex="{Binding SelectedPage}">
   <TabItem Header="Diagnostics"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="365"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><TextBlock Text="Diagnostic sequence" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="8 STAGES" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/></Grid>
     <ListBox Grid.Row="1" ItemsSource="{Binding Stages}" SelectedItem="{Binding Stage}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><Border Background="#2B3233" CornerRadius="5" Height="29" Width="27" VerticalAlignment="Center"><TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="19"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
     <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer x:Name="DiagnosticScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="ResultsGrid" Height="{Binding ViewportHeight,RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Stage.Title}" ToolTip="{Binding Stage.Description}" FontSize="21" FontWeight="SemiBold"/>
     <Border x:Name="ScanOverview" Grid.Row="1" Background="#182321" CornerRadius="7" Padding="10" Margin="0,10,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding ScanFocus.Title}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding ScanFocus.Traffic}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Packet findings" Command="{Binding OpenPacketPathCommand}" VerticalAlignment="Center" Padding="10,6"/>
     </Grid></Border>
     <StackPanel Grid.Row="2" Margin="0,8,0,0"><WrapPanel><Button Content="Run all checks" Command="{Binding BaselineCommand}" Style="{StaticResource Primary}" Margin="0,0,8,4" Padding="10,7"/><Button Content="Check both PCs" Command="{Binding CheckBothCommand}" Margin="0,0,8,4" Padding="10,7"/><Button Content="Run this stage" Command="{Binding RunStageCommand}" Margin="0,0,8,4" Padding="10,7"/><Button Content="Admin tools" Command="{Binding OpenAdminCommand}" Margin="0,0,0,4" Padding="10,7"/></WrapPanel><TextBlock x:Name="RunHelp" Text="Run all: test both directions, then inspect this PC. For the other PC's Windows checks, run all there too." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
      <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.RowDefinitions>
       <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding EvidenceExpanded}" Value="False"><Setter Property="Height" Value="Auto"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
       <RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="2*"/><Style.Triggers><DataTrigger Binding="{Binding LogExpanded}" Value="False"><Setter Property="Height" Value="Auto"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
      </Grid.RowDefinitions>
       <Expander x:Name="EvidencePanel" IsExpanded="{Binding EvidenceExpanded,Mode=TwoWay}" Margin="0,0,0,6"><Expander.Header><TextBlock><Run Text="Evidence · "/><Run Text="{Binding EvidenceCount,Mode=OneWay}"/></TextBlock></Expander.Header>
        <ListBox ItemsSource="{Binding Evidence}" SelectedItem="{Binding SelectedEvidence}" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Summary}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Summary}"/><TextBlock FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"><Run Text="{Binding Outcome}"/><Run Text=" · "/><Run Text="{Binding Stage}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       </Expander>
       <Expander x:Name="LogPanel" Grid.Row="1" IsExpanded="{Binding LogExpanded,Mode=TwoWay}"><Expander.Header><TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="Log / details · "/><Run Text="{Binding SelectedEvidence.Outcome,Mode=OneWay,TargetNullValue=No selection}"/></TextBlock></Expander.Header>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Copy selected details" Command="{Binding CopyEvidenceCommand}" HorizontalAlignment="Right" Padding="8,3" Margin="0,0,0,5"/><TextBox Grid.Row="1" Text="{Binding EvidenceDetail,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/></Grid>
       </Expander>
      </Grid>
    </Grid></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem Header="Protocols"><Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Check both PCs" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Click once on either paired PC. Both windows run the check and show the results." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="Check both PCs" Command="{Binding CheckBothCommand}" Style="{StaticResource Primary}" VerticalAlignment="Center"/></Grid>
    <TextBlock Text="{Binding ProtocolSummary}" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
    <Border Background="#182321" CornerRadius="7" Padding="12" Margin="0,14,0,12"><StackPanel><TextBlock Text="{Binding ScanFocus.Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ScanFocus.Detail}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock Text="{Binding PacketPathStatus}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border>
    <Grid Margin="10,0,10,6"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><TextBlock Text="TEST" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="DIRECTION" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="SEND" Style="{StaticResource Caption}"/><TextBlock Grid.Column="3" Text="RECEIVE" Style="{StaticResource Caption}"/><TextBlock Grid.Column="4" Text="RESULT" Style="{StaticResource Caption}"/></Grid>
    <ItemsControl ItemsSource="{Binding DirectionChecks}" Foreground="{StaticResource Text}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#141819" BorderBrush="#303638" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" ToolTip="{Binding Detail}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Protocol}" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding Direction}"/><TextBlock Foreground="{StaticResource Muted}" FontSize="10"><Run Text="{Binding Sender}"/><Run Text=" → "/><Run Text="{Binding Receiver}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding Send}" Margin="0,0,8,0"/><TextBlock Grid.Column="3" Text="{Binding Receive}" Margin="0,0,8,0"/><TextBlock Grid.Column="4" Text="{Binding Result}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="#E6BC78"/></DataTrigger><DataTrigger Binding="{Binding Result}" Value="Not tested"><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="These are application socket results. Run all checks adds Windows inspections and captures on the PC where you click it. A missing result does not prove which PC is faulty." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,20"/>
    <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="UDP" FontSize="26"/><TextBlock Text="200 numbered packets in each direction. Unique delivery, loss, duplicates, ordering, echo timing and arrival interval variation." Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><Button Content="Test UDP both ways" Style="{StaticResource Primary}" Command="{Binding UdpCommand}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="TCP" FontSize="26"/><TextBlock Text="Connect and transfer a bounded, verified payload in each direction. Report socket failures and acknowledged transfer time." Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><Button Content="Test TCP both ways" Style="{StaticResource Primary}" Command="{Binding TcpCommand}"/></StackPanel></Border></UniformGrid>
    <Button Content="Check path and MTU" Command="{Binding PathCommand}" HorizontalAlignment="Left" Margin="0,24,0,0"/><TextBlock Text="ICMP and no-fragment probes help inspect the path. They are reported separately from TCP and UDP tests." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></Border></TabItem>
    <TabItem Header="Admin tools"><Border Style="{StaticResource Card}"><ScrollViewer x:Name="AdminScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Prepare a way back. Then repair." FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="Create a Windows restore point on this PC before changing network settings. Choose one repair, review its effect, then repeat the failed test." Foreground="{StaticResource Muted}" LineHeight="22" Margin="0,10,0,16"/>
    <Border Background="#222820" BorderBrush="#454E3C" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,0,0,16">
     <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasPendingRecovery}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><TextBlock Text="Finish pending cleanup first" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="{Binding RecoveryStatus}" Foreground="#D4DAB5"/><WrapPanel Margin="0,12,0,0"><Button Content="Restore pending change" Command="{Binding RestoreCommand}" Margin="0,0,10,0"/><Button Content="Acknowledge reboot and retest" Command="{Binding AcknowledgeCommand}"/></WrapPanel></StackPanel>
    </Border>
    <Border Background="#182A23" BorderBrush="#365B48" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,0,0,20"><StackPanel>
     <TextBlock Text="1  ·  Create a Windows restore point" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding RestorePointStatus}" Foreground="#C5DECF" LineHeight="21" Margin="0,8,0,12"/>
     <Button Content="Create / verify Windows restore point" Style="{StaticResource Primary}" Command="{Binding CreateRestorePointCommand}" HorizontalAlignment="Left"/>
     <WrapPanel Margin="0,10,0,0"><Button Content="Open System Protection" Command="{Binding SystemProtectionCommand}" Margin="0,0,8,6"/><Button Content="Copy restore point name" Command="{Binding CopyRestoreNameCommand}" Margin="0,0,8,6"/><Button Content="Open System Restore" Command="{Binding SystemRestoreCommand}" Margin="0,0,0,6"/></WrapPanel>
      <Expander x:Name="RestoreDetailsPanel" Header="Restore-point progress and error details" IsExpanded="True" Margin="0,10,0,8"><StackPanel><Button Content="Copy restore-point details" Command="{Binding CopyRestoreErrorCommand}" HorizontalAlignment="Right" Padding="10,5" Margin="0,0,0,6"/><TextBox Text="{Binding RestoreAttemptDetail,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MinHeight="55" MaxHeight="190" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander>
      <TextBlock Text="A restore-point failure blocks repairs. You can still run diagnostics and packet captures, and copy or export their results." Foreground="{StaticResource Accent}" FontSize="11" Margin="0,4,0,6"/>
     <TextBlock Text="System Restore covers Windows system settings; keep separate backups of personal files. Creating a point can take several minutes. Opening recovery tools does not apply a restore." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel></Border>
    <TextBlock Text="2  ·  Choose one action" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox ItemsSource="{Binding AdminActions}" DisplayMemberPath="Label" SelectedItem="{Binding AdminAction}" Margin="0,0,0,12"/><TextBlock Text="{Binding AdminAction.Description}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" LineHeight="22"/>
    <TextBlock Text="{Binding AdminRequirement}" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
    <Button Content="Review and run with administrator access" Command="{Binding AdminCommand}" HorizontalAlignment="Left"/>
    <TextBlock Text="When a paired connection is available, a temporary QoS or capture window also runs UDP and TCP tests automatically. If communication is unavailable, the local operation still completes and stores its evidence." Foreground="{StaticResource Muted}" LineHeight="22"/>
   </StackPanel></ScrollViewer></Border></TabItem>
   <TabItem Header="VBAN"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="VBAN tools" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Integration follows the two-PC foundation." Foreground="{StaticResource Accent}" FontSize="16" Margin="0,16,0,16"/><TextBlock Text="The existing VBAN Testing Tool remains separate. This module will later bring in stream discovery, packet and audio diagnostics, and VoiceMeeter-specific checks." Foreground="{StaticResource Muted}" LineHeight="24"/><TextBlock Text="Port 6980 is included in port-ownership inspection. To test socket reception on 6980, close VoiceMeeter first and deliberately select 6980 as the test port on both endpoints. A successful generic test does not verify VBAN parsing or audio playback." Foreground="{StaticResource Muted}" LineHeight="24" Margin="0,20,0,0"/></StackPanel></Border></TabItem>
   <TabItem Header="Packet path"><Border Style="{StaticResource Card}"><ScrollViewer x:Name="PacketPathScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="Follow the test traffic" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding PacketPathStatus}" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
    <Border Background="#182321" BorderBrush="#36504A" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="{Binding ScanFocus.Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ScanFocus.Traffic}" Margin="0,7,0,7"/>
     <TextBlock Text="{Binding ScanFocus.Capture}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ScanFocus.Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
    </StackPanel></Border>
    <ComboBox ItemsSource="{Binding PacketPaths}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedPacketPath}" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding SelectedPacketPath.TestIdentity}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
    <Border Background="#24251D" BorderBrush="#4C4B35" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
     <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding SelectedPacketPath.Finding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><TextBlock Text="{Binding SelectedPacketPath.Finding.Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding SelectedPacketPath.Finding.Evidence}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,8"/>
      <TextBlock Text="{Binding SelectedPacketPath.Finding.NextStep}" FontSize="12"/><Button Content="Open suggested stage" Command="{Binding InspectFindingCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding SelectedPacketPath.Checkpoints}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="#141819" BorderBrush="#303638" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}" FontSize="11" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D3BE88"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Observed"><Setter Property="Foreground" Value="#72D5B2"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Verified by Elka"><Setter Property="Foreground" Value="#72D5B2"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Drop reported"><Setter Property="Foreground" Value="#F3988D"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
     </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Observed Windows components" FontSize="16" FontWeight="SemiBold" Margin="0,15,0,8"/>
    <TextBlock Text="{Binding SelectedPacketPath.Observations}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" LineHeight="19"/>
    <TextBlock Text="A gap means the next checkpoint was not observed. Only an explicit drop report identifies a reported rejection. VBAN stream and audio checks will be added after this generic foundation." Foreground="{StaticResource Muted}" Margin="0,15,0,0"/>
   </StackPanel></ScrollViewer></Border></TabItem>
   <TabItem Header="Packet viewer"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Packets, decoded by Wireshark" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding ToolsStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,10"/></StackPanel>
    <WrapPanel Grid.Row="1"><Button Content="Set up Wireshark + Npcap" Command="{Binding InstallCaptureToolsCommand}" Margin="0,0,8,8"/><Button Content="Refresh tools" Command="{Binding RefreshToolsCommand}" Margin="0,0,8,8"/><Button Content="Capture selected flow" Style="{StaticResource Primary}" Command="{Binding CaptureNpcapCommand}" Margin="0,0,8,8"/><Button Content="Open capture file" Command="{Binding OpenCaptureCommand}" Margin="0,0,0,8"/></WrapPanel>
    <TextBlock Grid.Row="2" Text="{Binding PacketViewerStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,10"/>
    <ListBox Grid.Row="3" ItemsSource="{Binding Packets}" SelectedItem="{Binding SelectedPacket}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="92"/><ColumnDefinition Width="165"/><ColumnDefinition Width="165"/><ColumnDefinition Width="62"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Protocol}" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding Source}" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="3" Text="{Binding Destination}" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="4" Text="{Binding Length}" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="5" Text="{Binding Info}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Grid Grid.Row="4" Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Packet details and bytes" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Show packet details" Command="{Binding InspectPacketCommand}" Margin="8,0,8,0" Padding="10,6"/><Button Grid.Column="2" Content="Open in Wireshark" Command="{Binding OpenWiresharkCommand}" Padding="10,6"/></Grid>
    <TextBox Grid.Row="5" Text="{Binding PacketDetail,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </Grid></Border></TabItem>
  </TabControl>
   <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SessionLabel}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0"/><Button Content="New session" Command="{Binding NewSessionCommand}" Margin="0,0,8,0"/><Button Content="Copy for support" Command="{Binding SupportCommand}" Margin="0,0,8,0"/><Button Content="Import" Command="{Binding ImportCommand}" Margin="0,0,8,0"/><Button Content="Export ZIP" Command="{Binding ExportCommand}"/></StackPanel></Grid>
 </Grid>
</Window>
